<section class="visit-card" id="visitCard" tabindex="0" role="button" aria-label="Show your club check-in code">
  <div class="visit-icon">✳</div><div><span>YOUR CLUB CARD</span><strong>Check in & sip on</strong><small>Show your code at the counter</small></div><button class="visit-cta" id="visitButton" aria-label="Show QR code">↗</button>
</section>
<div class="qr-modal" id="qrModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="qrTitle"><div class="qr-sheet"><button class="close" id="closeQr" aria-label="Close">×</button><p class="eyebrow">BROONIC CLUB CHECK-IN</p><h2 id="qrTitle">Show this code<br />at the counter</h2><div class="qr-wrap"><img src="/visit-qr.svg" alt="Check-in code" /><span class="scan-line"></span></div><p class="qr-note">For your next Broonic coffee visit.</p><div class="visit-success" id="visitSuccess">✳ <strong>You're all checked in!</strong><span>One cup closer to a treat.</span></div></div></div>
<script>
  const card = document.querySelector('#visitCard'); const modal = document.querySelector('#qrModal'); const close = document.querySelector('#closeQr'); const success = document.querySelector('#visitSuccess');
  const open = () => { modal.classList.add('open'); modal.setAttribute('aria-hidden', 'false'); close.focus(); setTimeout(() => success.classList.add('show'), 650); };
  const shut = () => { modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); success.classList.remove('show'); card.focus(); };
  card.addEventListener('click', open); card.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } }); close.addEventListener('click', shut); modal.addEventListener('click', (event) => { if (event.target === modal) shut(); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && modal.classList.contains('open')) shut(); });
</script>
