---
const { active = 'inicio' } = Astro.props;
const links = [
  { key: 'inicio', label: 'Inicio', href: '/', icon: 'home' },
  { key: 'menu', label: 'Menú', href: '/menu/', icon: 'menu' },
  { key: 'bebidas', label: 'Bebidas', href: '/bebidas/', icon: 'cup' },
  { key: 'perfil', label: 'Perfil', href: '/perfil/', icon: 'user' },
];
---
<nav class="bottom-nav" aria-label="Navegación principal">
  {links.slice(0, 2).map((link) => <a href={link.href} class:list={{ active: active === link.key }}><svg viewBox="0 0 24 24">{link.icon === 'home' ? <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z"/> : <><path d="M4 5h16M4 12h16M4 19h10"/></>}</svg><span>{link.label}</span></a>)}
  <a class="order-fab" href="/carrito/" aria-label="Crear pedido Pick and Go"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></a>
  {links.slice(2).map((link) => <a href={link.href} class:list={{ active: active === link.key }}><svg viewBox="0 0 24 24">{link.icon === 'cup' ? <><path d="M6 7h12v8a6 6 0 0 1-12 0V7Z"/><path d="M18 9h2a2 2 0 0 1 0 4h-2M8 4h8"/></> : <><circle cx="12" cy="8" r="4"/><path d="M4 21c.8-4 3.4-6 8-6s7.2 2 8 6"/></>}</svg><span>{link.label}</span></a>)}
</nav>
