---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import BottomNav from '../components/BottomNav.astro';
---
<Layout title="Broonic · Profile"><main class="app-shell"><section class="app"><AppHeader title="Your space" back={true} /><div class="content"><p class="eyebrow">YOUR LITTLE CORNER</p><h1>HEY THERE,<br /><i>SOFIA.</i></h1><section class="profile"><div class="avatar">S</div><div><strong>Sofia Martinez</strong><span>Broonic coffee club member</span></div></section><section class="rewards-card"><span>YOUR COFFEE CLUB CARD</span><strong><b>08</b> / 12 VISITS</strong><p>Four more visits until your next cup is on us.</p><div class="progress"><i></i></div></section><section style="margin-top:32px"><p class="eyebrow">YOUR DETAILS</p><div class="setting"><span>Personal information</span><b>↗</b></div><div class="setting"><span>Payment methods</span><b>↗</b></div><div class="setting"><span>Favorite drinks</span><b>↗</b></div><div class="setting"><span>Notifications</span><b>↗</b></div></section></div><BottomNav active="profile" /></section></main></Layout>
