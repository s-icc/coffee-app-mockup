---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import BottomNav from '../components/BottomNav.astro';
import ProductCard from '../components/ProductCard.astro';
import { menuItems } from '../data/MenuItem';
---
<Layout title="Broonic · Your drinks"><main class="app-shell"><section class="app"><AppHeader title="Your drinks" back={true} /><div class="content"><p class="eyebrow">YOUR USUALS</p><h1>THE ONES<br />YOU <i>LOVE.</i></h1><section class="banner"><strong>Honey oat latte</strong><p>For mornings that need a little sweetness.</p></section><div class="section-heading"><div><p class="eyebrow">ORDER IT AGAIN</p><h2>Back for more?</h2></div></div><section class="product-list"><ProductCard item={menuItems[0]} /><ProductCard item={menuItems[2]} /></section><section class="info-card"><span>TRY SOMETHING NEW</span><h2>Meet cloud matcha.</h2><p>Soft, creamy, and made for a slow morning.</p></section></div><BottomNav active="drinks" /></section></main></Layout>
