---
import Layout from '../layouts/Layout.astro'; import AppHeader from '../components/AppHeader.astro'; import BottomNav from '../components/BottomNav.astro'; import ProductCard from '../components/ProductCard.astro'; import { menuItems } from '../data/MenuItem';
---
<Layout title="Marea Café · Mis bebidas"><main class="app-shell"><section class="app"><AppHeader title="Mis bebidas" back={true} /><div class="content"><p class="eyebrow">TU HISTORIAL</p><h1>Las de<br /><i>siempre.</i></h1><section class="banner"><strong>☕ Latte de miel</strong><p>Tu bebida favorita · pedida 14 veces</p></section><div class="section-heading" style="margin-top:30px"><div><p class="eyebrow">PEDIDAS RECIENTEMENTE</p><h2>Vuelve a pedir</h2></div></div><section class="product-list" style="margin-top:17px"><ProductCard item={menuItems[0]} /><ProductCard item={menuItems[2]} /></section><section class="info-card"><span>RECOMENDACIÓN</span><h3>Prueba el Matcha nube</h3><p>Suave, cremoso y perfecto para una mañana lenta.</p></section></div><BottomNav active="bebidas" /></section></main></Layout>
