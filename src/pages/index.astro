---
import Layout from '../layouts/Layout.astro';
import { menuItems } from '../data/MenuItem';
---
<Layout title="Broonic — The social side of coffee">
  <header class="site-header">
    <a class="site-brand" href="/" aria-label="Broonic home">BROONIC<span>®</span></a>
    <nav aria-label="Main navigation"><a href="#story">Our story</a><a href="#menu">The menu</a><a href="#club">The club</a></nav>
    <a class="header-cta" href="/app/">OPEN THE APP <span>↗</span></a>
  </header>
  <main>
    <section class="landing-hero" aria-labelledby="hero-title">
      <p class="hero-kicker" data-hero>GOOD COFFEE. BETTER COMPANY.</p>
      <h1 id="hero-title" class="sr-only">Broonic — the social side of coffee</h1>
      <img class="hero-wordmark" src="/broonic-wordmark.png" alt="BROONIC — the social side of coffee" width="1280" height="1280" fetchpriority="high" />
      <div class="hero-bottom" data-hero><p>A coffee club for the moments<br />worth sharing.</p><a class="round-arrow" href="#story" aria-label="Scroll to our story">↓</a><span>SCROLL TO EXPLORE&nbsp; 01 / 04</span></div>
    </section>

    <div class="marquee" aria-hidden="true"><div>THE SOCIAL SIDE OF COFFEE <span>✳</span> COME AS YOU ARE <span>✳</span> THE SOCIAL SIDE OF COFFEE <span>✳</span> COME AS YOU ARE <span>✳</span></div></div>

    <section class="story-section section-pad" id="story">
      <div class="story-copy" data-reveal>
        <p class="overline">01 / THE IDEA</p>
        <h2>COFFEE IS<br /><em>BETTER</em><br />TOGETHER.</h2>
        <p class="story-lede">A familiar face, a favorite cup, a reason to stay a little longer. Broonic is made for all of it.</p>
        <a class="text-link" href="#club">GET TO KNOW THE CLUB <span>↗</span></a>
      </div>
      <div class="story-art" data-reveal><div class="dog-image" role="img" aria-label="Broonic's French bulldog mascot wearing a coffee cup"></div><div class="art-caption"><span>OUR RESIDENT COFFEE LOVER</span><span>MEET BROO ↗</span></div></div>
    </section>

    <section class="statement-section" id="club">
      <div class="statement-inner"><p class="overline" data-reveal>02 / THE CLUB</p><h2 data-reveal>MORE THAN<br />A <span>CUP.</span></h2><div class="statement-row" data-reveal><p>A place to pause. A place to connect. Your everyday coffee ritual, with a little more heart.</p><a class="pill-button light" href="/app/">EXPLORE THE APP <span>↗</span></a></div></div>
      <img class="statement-stamp" src="/broonic-round.png" alt="Broonic coffee club dog emblem" width="1280" height="1280" loading="lazy" />
    </section>

    <section class="menu-section section-pad" id="menu">
      <div class="menu-heading" data-reveal><div><p class="overline">03 / MADE FOR YOUR MOMENT</p><h2>YOUR USUAL,<br /><em>OR SOMETHING NEW.</em></h2></div><a class="text-link" href="/menu/">VIEW FULL MENU <span>↗</span></a></div>
      <div class="landing-products">
        {menuItems.slice(0,3).map((item, index) => <a class={`landing-product ${item.tone}`} href="/menu/" data-reveal><div class="product-visual"><span class="cup-illustration"><i></i></span><small>0{index+1}</small></div><div class="product-bottom"><div><span>{item.category}</span><h3>{item.name}</h3></div><b>${item.price}</b></div></a>)}
      </div>
    </section>

    <section class="app-promo section-pad" id="app"><div class="app-promo-copy" data-reveal><p class="overline">04 / ALWAYS WITH YOU</p><h2>YOUR COFFEE<br />CLUB, <em>TO GO.</em></h2><p>Browse the menu, save your favorites, and get your next cup going—all from one little place.</p><a class="pill-button" href="/app/">STEP INTO THE APP <span>↗</span></a></div><a class="phone-preview" href="/app/" aria-label="Explore the Broonic mobile app" data-reveal><div class="phone-top"><span>9:41</span><span>●●●</span></div><div class="phone-logo">BROONIC</div><p>HEY, COFFEE LOVER.</p><h3>YOUR DAY LOOKS<br />BETTER WITH<br /><em>COFFEE.</em></h3><div class="phone-feature"><span>THE BROONIC PICK</span><strong>Honey oat latte</strong><b>ORDER YOURS ↗</b></div><div class="phone-nav">⌂　 ▦　 <b>＋</b>　♡　◯</div></a></section>
  </main>
  <footer class="landing-footer"><div class="footer-top"><span>BROONIC®</span><a href="/app/">LET'S GET COFFEE ↗</a></div><div class="footer-lockup">BROONIC</div><div class="footer-bottom"><span>THE SOCIAL SIDE OF COFFEE</span><span>GOOD COFFEE. GOOD COMPANY. ALWAYS.</span><a href="#hero-title">BACK TO TOP ↑</a></div></footer>
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.from('[data-hero]', { y: 25, autoAlpha: 0, duration: 0.9, stagger: 0.14, delay: 0.2, ease: 'power3.out' });
      gsap.from('.hero-wordmark', { scale: 0.88, autoAlpha: 0, duration: 1.3, delay: 0.12, ease: 'power3.out' });
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => gsap.from(element, { y: 46, autoAlpha: 0, duration: 0.95, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } }));
      gsap.to('.statement-stamp', { rotation: 28, y: -70, ease: 'none', scrollTrigger: { trigger: '.statement-section', start: 'top bottom', end: 'bottom top', scrub: 1 } });
    }
  </script>
</Layout>
